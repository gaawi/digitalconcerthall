# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Never commit .env.local.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used by the seed script. NEVER expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: the public site URL (used for auth email redirects in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
